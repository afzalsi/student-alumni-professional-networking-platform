PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/alumni_portal
JWT_SECRET=super_secret_jwt_key_for_alumni_portal_development_2026!
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173

# Optional Cloudinary (Local storage fallback is active when these are empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Email SMTP (Mock logger fallback is active when these are empty)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@alumniportal.edu

# Platform settings
AUTO_APPROVE_JOBS=false
